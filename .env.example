# ===== LLM（示例：DeepSeek，按需替换为任何 OpenAI 兼容服务）=====
# 获取：https://platform.deepseek.com/api_keys
# 必须是纯 ASCII 字符串，不能含中文
LLM_API_KEY=sk-your-llm-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
# 推荐候选：
#   deepseek-chat       —— DeepSeek-V3 (671B)，中文友好
#   deepseek-reasoner   —— DeepSeek-R1，强推理（耗 token 更多）
LLM_MODEL=deepseek-chat

# ===== Embedding（示例：DeepSeek 兼容服务；也可换 OpenAI / 其他）=====
# 注：DeepSeek 不提供 embedding，需要单独的 embedding 服务
# 可选服务商：OpenAI text-embedding-3 / 智源 BGE / Cohere / Voyage 等
EMBEDDING_API_KEY=sk-your-embedding-api-key-here
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# 意图分类（用便宜的小模型即可）
INTENT_MODEL=deepseek-chat

# ===== 重排（Reranker）=====
# 国内推荐：SiliconFlow（https://siliconflow.cn）提供 BGE-Reranker
# 海外推荐：Cohere Rerank / Jina Rerank
RERANK_API_KEY=sk-your-rerank-api-key-here
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ===== 向量库（任选其一）=====
# 方案 A：ChromaDB（嵌入式，零依赖，推荐个人项目）
CHROMA_DB_PATH=./backend/vector_db/chroma
CHROMA_COLLECTION=ai_me_kb

# 方案 B：Milvus Lite（嵌入式，pymilvus 自带）
# MILVUS_DB_PATH=./backend/vector_db/milvus.db
# MILVUS_COLLECTION=ai_me_kb

# ===== LangSmith（可选，用于全链路追踪）=====
# 获取：https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-me
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ===== 服务配置 =====
APP_HOST=0.0.0.0
APP_PORT=8001
APP_DEBUG=false

# ===== 应用行为 =====
MAX_INPUT_LENGTH=2000
MAX_RETRIEVE_BLOCKS=10
RERANK_TOP_K=5
TEMPERATURE=0.3
ENABLE_RECOMMEND_QUESTION=true

# ===== 限流 =====
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10
