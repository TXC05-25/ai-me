# 强制所有 shell / dockerfile / yaml 使用 LF 行尾
# 否则 Windows 编辑后在 Linux 跑会因 CRLF 报 '\r': command not found
*               text=auto

# 明确指定
*.sh            text eol=lf
Dockerfile      text eol=lf
*.dockerfile    text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.py            text eol=lf
*.md            text eol=lf
*.html          text eol=lf
*.js            text eol=lf
*.css           text eol=lf
*.conf          text eol=lf
*.gitignore     text eol=lf
.gitattributes  text eol=lf
